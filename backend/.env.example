# LLM settings are read only from environment variables and never stored in the database.
LLM_PROVIDER=openai_compatible
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek native example:
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com

# Server
HOST=0.0.0.0
PORT=8000

# Live trading safety gate (keep false until a reviewed broker adapter is configured)
LIVE_TRADING_ENABLED=false

# Data cache
DATABASE_PATH=./data/cache.db
CHECKPOINT_DATABASE_PATH=./data/checkpoints.db
CHECKPOINT_DATABASE_URL=
CHECKPOINT_RETENTION_DAYS=30

# S3-compatible artifact storage (AWS S3, MinIO, Ceph, R2, etc.)
S3_ENDPOINT_URL=https://s3.example.com
S3_BUCKET=a-share-agent
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_ADDRESSING_STYLE=path
S3_ARTIFACTS_PREFIX=a-share-agent/artifacts

# Serper web search (optional; leave empty to disable)
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev
SERPER_GL=cn
SERPER_HL=zh-cn
DDGS_REGION=cn-zh
DDGS_SAFESEARCH=moderate

# Langfuse observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
