# LLM settings are read only from environment variables and never stored in the database.
LLM_PROVIDER=openai_compatible
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
# Optional override for custom models; otherwise the built-in model catalog is used.
# LLM_CONTEXT_WINDOW=128000
LLM_MAX_OUTPUT_TOKENS=8192
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek native example:
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com

# Server
HOST=0.0.0.0
PORT=18000
FRONTEND_PORT=15173
BACKEND_PORT=18000

# Live trading safety gate (keep false until a reviewed broker adapter is configured)
LIVE_TRADING_ENABLED=false
AUTOMATION_MAX_CONCURRENCY=3

# Local SQLite database for single-node mode (ignored when DATABASE_URL is set)
DATABASE_PATH=./data/cache.db
# PostgreSQL database for durable runtime state and multi-node mode.
# Leave empty to use SQLite single-node mode; PostgreSQL example:
# DATABASE_URL=postgres://postgres:password@localhost:5432/a_share_agent
DATABASE_URL=
CHECKPOINT_DATABASE_PATH=./backend/data/checkpoints.db
CHECKPOINT_DATABASE_URL=
CHECKPOINT_RETENTION_DAYS=30

# S3-compatible artifact storage (AWS S3, MinIO, Ceph, R2, etc.)
S3_ENDPOINT_URL=https://s3.example.com
# Optional model-facing endpoint; defaults to S3_ENDPOINT_URL.
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=a-share-agent
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_ADDRESSING_STYLE=path
S3_ARTIFACTS_PREFIX=a-share-agent/artifacts

# Dedicated S3-compatible bucket for permanent historical market-data cache.
# Qiniu example: endpoint=https://s3.cn-south-1.qiniucs.com, region=cn-south-1.
# Keep SESSION_TOKEN empty for Qiniu Kodo.
MARKET_HISTORY_CACHE_ENABLED=false
MARKET_HISTORY_S3_ENDPOINT_URL=
MARKET_HISTORY_S3_BUCKET=
MARKET_HISTORY_S3_REGION=us-east-1
MARKET_HISTORY_S3_ACCESS_KEY_ID=
MARKET_HISTORY_S3_SECRET_ACCESS_KEY=
MARKET_HISTORY_S3_SESSION_TOKEN=
MARKET_HISTORY_S3_ADDRESSING_STYLE=path
MARKET_HISTORY_S3_PREFIX=a-share-agent/market-history/v1

# Serper web search (optional; leave empty to disable)
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev
SERPER_GL=cn
SERPER_HL=zh-cn

# AnySearch unified web search (optional; explicit search_web_anysearch also works anonymously)
ANYSEARCH_API_KEY=
ANYSEARCH_BASE_URL=https://api.anysearch.com
ANYSEARCH_ZONE=cn
ANYSEARCH_LANGUAGE=zh-CN

DDGS_REGION=cn-zh
DDGS_SAFESEARCH=moderate

# LangSmith observability (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=a-share-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Langfuse observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
