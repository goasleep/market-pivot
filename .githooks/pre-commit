#!/bin/sh

set -eu

git diff --cached --check

staged_files=$(git diff --cached --name-only)

if printf '%s\n' "$staged_files" | grep -Eq '^backend/'; then
  echo "Running backend checks..."
  (cd backend && uv run ruff check src tests && uv run pytest)
fi

if printf '%s\n' "$staged_files" | grep -Eq '^frontend/|^package.json$|^pnpm-lock.yaml$'; then
  echo "Running frontend checks..."
  pnpm build:frontend
  pnpm lint
fi
