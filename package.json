{
  "name": "a-share-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A-Share AI Agent Trading Simulation System",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "cd backend && uv run uvicorn api.main:app --app-dir src --reload --port 8000",
    "dev": "concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "build:frontend": "pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint",
    "format": "prettier --write \"frontend/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
